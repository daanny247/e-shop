FLASK_ENV=development
SECRET_KEY=cambia-esta-clave-por-una-secreta-y-aleatoria

# Desarrollo local: variables sueltas
DB_USER=usuario_db
DB_PASSWORD=contraseña_db
DB_HOST=localhost
DB_NAME=scenthub_db

# Alternativa para plataformas como Railway: una sola URL de conexión.
# Si DATABASE_URL está definida, tiene prioridad sobre las 4 variables de arriba.
# DATABASE_URL=mysql://usuario:contraseña@host:puerto/nombre_db
